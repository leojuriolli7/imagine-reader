DATABASE_URL=postgres://imagine:imagine_local@localhost:55432/imagine_reader
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
SMTP_URL=smtp://localhost:51025
EMAIL_FROM=ImagineReader <reader@imagine.local>
# demo exercises the workflow without making AI provider calls.
AI_MODE=demo
OPENAI_API_KEY=
PLANNER_MODEL=gpt-4.1-mini
IMAGE_MODEL=gpt-image-2
# Same S3 adapter for local SeaweedFS and cloud object storage.
S3_ENDPOINT=http://localhost:58333
S3_BUCKET=imagine-reader
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true
AWS_ACCESS_KEY_ID=imagine-local
AWS_SECRET_ACCESS_KEY=imagine-local-secret
AWS_SESSION_TOKEN=
# Optional test-only overrides (defaults match the local services).
TEST_DATABASE_URL=postgres://imagine:imagine_local@localhost:55432/imagine_reader_test
TEST_SMTP_URL=smtp://localhost:51025
TEST_S3_ENDPOINT=http://localhost:58333
TEST_S3_BUCKET=imagine-reader-test
TEST_S3_ACCESS_KEY_ID=imagine-local
TEST_S3_SECRET_ACCESS_KEY=imagine-local-secret
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
NODE_ENV=development
PORT=3000
OTEL_SERVICE_NAME=imagine-reader
