{
  "name": "@imagine/local-observability",
  "private": true,
  "scripts": {
    "start": "docker compose up -d --wait",
    "stop": "docker compose down",
    "logs": "docker compose logs --follow",
    "status": "docker compose ps",
    "traces": "tsx src/inspect.ts traces",
    "trace": "tsx src/inspect.ts trace",
    "events": "tsx src/inspect.ts events",
    "typecheck": "tsc --noEmit"
  },
  "type": "module",
  "dependencies": {
    "effect": "4.0.0-rc.112",
    "@effect/platform-node": "4.0.0-rc.112"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "@types/node": "^22"
  }
}
