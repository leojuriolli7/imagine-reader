{
  "name": "imagine-reader",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "pnpm env:check && dotenv -e .env -- turbo dev --filter=web --filter=@imagine/worker",
    "build": "dotenv -e .env -- turbo build",
    "start": "pnpm start:web",
    "worker": "pnpm start:worker",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "dotenv -e .env -- pnpm --filter @imagine/server test:integration",
    "lint": "oxlint --deny-warnings",
    "format": "biome format --write .",
    "typecheck": "turbo typecheck",
    "db:migrate": "dotenv -e .env -- pnpm --filter @imagine/server db:migrate",
    "services:up": "docker compose up -d --wait && pnpm storage:start && pnpm telemetry:start",
    "services:down": "docker compose down && pnpm storage:stop && pnpm telemetry:stop",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test",
    "postinstall": "node scripts/pdf-worker.mjs",
    "test:coverage": "vitest run --coverage",
    "local:setup": "node scripts/setup.mjs",
    "local:up": "pnpm local:setup && pnpm services:up && pnpm db:migrate && pnpm env:check && pnpm storage:check",
    "env:check": "dotenv -e .env -- pnpm --filter @imagine/server env:check",
    "storage:check": "dotenv -e .env -- pnpm --filter @imagine/server storage:check",
    "storage:start": "pnpm --filter @imagine/local-storage start",
    "storage:stop": "pnpm --filter @imagine/local-storage stop",
    "storage:logs": "pnpm --filter @imagine/local-storage logs",
    "dev:web": "pnpm env:check && dotenv -e .env -- pnpm --filter web dev",
    "dev:worker": "pnpm env:check && dotenv -e .env -- pnpm --filter @imagine/worker dev",
    "start:web": "pnpm env:check && dotenv -e .env -- pnpm --filter web start",
    "start:worker": "pnpm env:check && dotenv -e .env -- pnpm --filter @imagine/worker start",
    "deploy:prepare": "pnpm env:check && pnpm storage:check && pnpm check && pnpm build",
    "storage:restart": "pnpm --filter @imagine/local-storage run restart",
    "format:check": "biome format .",
    "telemetry:start": "pnpm --filter @imagine/local-observability start",
    "telemetry:stop": "pnpm --filter @imagine/local-observability stop",
    "telemetry:logs": "pnpm --filter @imagine/local-observability logs",
    "telemetry:status": "pnpm --filter @imagine/local-observability status",
    "telemetry:traces": "pnpm --filter @imagine/local-observability traces",
    "telemetry:trace": "pnpm --filter @imagine/local-observability trace",
    "telemetry:events": "pnpm --filter @imagine/local-observability events"
  },
  "devDependencies": {
    "@biomejs/biome": "latest",
    "@effect/vitest": "4.0.0-rc.112",
    "@oxlint/plugins": "1.81.0",
    "@types/node": "^22",
    "@vitest/coverage-v8": "^4.1.10",
    "dotenv-cli": "latest",
    "effect": "4.0.0-rc.112",
    "oxlint": "1.81.0",
    "tsx": "latest",
    "turbo": "^2.9.18",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=22.13.0"
  },
  "type": "module"
}
